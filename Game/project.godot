; Engine configuration file.

config_version=5

[application]

config/name="Goldmember 69"
config/description="An original late-90s console-style spy FPS."
run/main_scene="res://ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Sound="*res://autoload/sound.gd"
Effects="*res://autoload/effects.gd"
Game="*res://autoload/game.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=240
window/size/window_width_override=1280
window/size/window_height_override=960
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/retro_pipeline/plugin.cfg")

[gui]

theme/default_font_antialiasing=0

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="guards"
3d_physics/layer_4="interact"
3d_physics/layer_5="pickups"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
textures/canvas_textures/default_texture_filter=0

[shader_globals]

retro_three_point={
"type": "bool",
"value": true
}
